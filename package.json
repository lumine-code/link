{
  "name": "link",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Open the http(s) link under the cursor in your default browser.",
  "keywords": [
    "url",
    "hyperlink",
    "browser",
    "http",
    "https"
  ],
  "repository": "https://github.com/lumine-code/link",
  "bugs": {
    "url": "https://github.com/lumine-code/link/issues"
  },
  "license": "MIT",
  "main": "./lib/link",
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can open the http link under the cursor in your browser without leaving the editor."
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationCommands": {
    "atom-workspace": [
      "link:open"
    ]
  },
  "dependencies": {
    "@lumine-code/underscore-plus": "https://github.com/lumine-code/underscore-plus.git#2b75d264c2ca01d27ee69d7cd05610a097011274"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
