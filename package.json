{
  "name": "link",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Open web links in the browser and Markdown file links in the editor.",
  "keywords": [
    "markdown",
    "url",
    "hyperlink",
    "navigation",
    "browser",
    "http",
    "https"
  ],
  "repository": "https://github.com/lumine-code/link",
  "bugs": {
    "url": "https://github.com/lumine-code/link/issues"
  },
  "license": "MIT",
  "main": "./lib/link",
  "files": [
    "keymaps",
    "lib",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "specPackages": [
    "language-hyperlink",
    "language-gfm",
    "language-ipython",
    "language-python",
    "language-latex",
    "language-html",
    "language-xml",
    "language-javascript",
    "language-json",
    "language-shellscript",
    "language-yaml",
    "language-toml",
    "language-css",
    "language-typst",
    "hyperclick"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "hyperclick.provider": {
      "versions": {
        "1.0.0": "provideHyperclick"
      }
    },
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "dependencies": {
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#857ec7ff4447161e51419ff7c36a06e7fc1084ae"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
