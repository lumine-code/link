{
  "name": "link",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Open the http(s) link under the cursor in your default browser.",
  "keywords": [
    "url",
    "hyperlink",
    "browser",
    "http",
    "https"
  ],
  "repository": "https://github.com/lumine-code/link",
  "bugs": {
    "url": "https://github.com/lumine-code/link/issues"
  },
  "license": "MIT",
  "main": "./lib/link",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can open the http link under the cursor in your browser without leaving the editor."
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationCommands": {
    "lumine-workspace": [
      "link:open"
    ]
  },
  "dependencies": {
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#7abe38681700c81e6e69a53fbd2c9fd2835ff066"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
